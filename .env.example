# Application Configuration Template
# Copy this file to .env and configure strong secrets before running in production

API_TITLE="Employee Management API"
API_VERSION="1.0.0"
DATABASE_URL="sqlite:///./employees.db"

# Security & Authentication (Required - minimum 32 characters each)
SECRET_KEY="replace-with-a-secure-random-32-char-secret-key-in-prod"
API_KEY="replace-with-a-secure-random-32-char-api-key-for-employees"
ADMIN_API_KEY="replace-with-a-secure-random-32-char-api-key-for-admins"

TOKEN_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_BONUS_PERCENTAGE=10.0
MAX_BONUS_PERCENTAGE=100.0
MAX_SALARY_LIMIT=100000000.00
